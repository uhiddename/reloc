# An allowlist: everything stays out of the build context unless listed
# here, so a new file (a dump, a key, a generated .conf) can't slip in.
*
!go.mod
!go.sum
!cmd/
!internal/
!migrations/
!web/
# Dependencies are installed and dist is built inside the image, never
# copied from the host; .gitkeep keeps //go:embed working without a build.
web/node_modules/
web/dist/*
!web/dist/.gitkeep

# Generated configs hold private keys; only test fixtures may go in.
**/*.conf
!internal/*/testdata/*.conf
